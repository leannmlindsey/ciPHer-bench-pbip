# pbip.env — paths for running PBIP on cipher data
#
#   cp config/pbip.env.template pbip.env
#   pico pbip.env  ; source pbip.env

# ─── Single data root ────────────────────────────────────────────────────
# Unzip ciPHer-bench-pbip-data.zip into <repo_root>/data/.
# Layout under data/:
#   data/PBIP/                                   = $PBIP_REPO
#       model/dataset_PBIP/final_model.h5
#       data/PBIP/host/*.txt (120 UniRep features)
#       data/PBIP/phage/*.txt (103 UniRep features)
#   data/cipher/data/validation_data/HOST_RANGE/PBIP/metadata/...   = $CIPHER_REPO
#   data/cipher_val_genomes/PBIP/metadata/...                       = $CIPHER_VAL_GENOMES
export PBIP_DATA_DIR=/path/to/ciPHer-bench-pbip/data

# ─── Derived paths ────────────────────────────────────────────────────────
export PBIP_REPO=${PBIP_DATA_DIR}/PBIP
export CIPHER_REPO=${PBIP_DATA_DIR}/cipher
export CIPHER_VAL_GENOMES=${PBIP_DATA_DIR}/cipher_val_genomes
export PBIP_OUTPUT_ROOT=${PBIP_DATA_DIR}/_predictions

# ─── Conda env name ───────────────────────────────────────────────────────
export PBIP_CONDA_ENV=pbip

# ─── SLURM defaults (DeltaAI GPU partition) ──────────────────────────────
export ACCOUNT=bfzj-dtai-gh
export PARTITION=ghx4
export GPUS_PER_NODE=1
