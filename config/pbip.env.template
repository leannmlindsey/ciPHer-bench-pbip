# pbip.env — paths for running PBIP (Ma et al. 2025) on cipher data
#
#   cp config/pbip.env.template pbip.env
#   pico pbip.env                          # set the paths below
#   source pbip.env

# ─── Upstream PBIP code + Google Drive download (~1.6 GB) ────────────────
# git clone https://github.com/a1678019300/PBIP.git
# Download the 6 zips from the Google Drive folder in their README:
#   https://drive.google.com/drive/folders/1c1JNePxM5IFlTqt6CglUHWi-J-Z_1uoo
# Extract into PBIP/ so it contains: model/, data/, bac_faa/, bac_fasta/,
# phage_faa/, phage_fasta/.
export PBIP_REPO=/path/to/PBIP

# ─── Cipher per-dataset genomes (PBIP interaction matrix lives here) ─────
export CIPHER_VAL_GENOMES=/path/to/cipher_data/validation_genomes

# ─── Cipher repo (alternate location of interaction matrix) ──────────────
export CIPHER_REPO=/path/to/cipher

# ─── Output root for predictions ─────────────────────────────────────────
export PBIP_OUTPUT_ROOT=/path/to/pbip_predictions

# ─── Conda env name ───────────────────────────────────────────────────────
export PBIP_CONDA_ENV=pbip
